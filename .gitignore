# Timing campaigns: per-row working trees with rebuilt cubatures and the ROM
# snapshot matrices (~17 GB each). The numbers they produce live in the decks
# and in Results_Paper/model_hyperparameters.md; the trees are local archives.
Results_Paper/FinalTable*/
FinalTable/

# Euclidean PROM enrichment campaigns: large, reproducible per-run outputs.
Project_YvonMaday/Results_Paper/euclidean_prom_enrichment_lhs*/Runs/

# Reproducible Case-2+B3 cubature fits, audits, and rollout outputs.
Project_YvonMaday/Results_Paper/euclidean_case2_hyperreduction/

# Resumable Euclidean HPROM campaign checkpoints, rules, runs, and timings.
Project_YvonMaday/Results_Paper/euclidean_hprom_main/

# Local and Sherlock artifacts from the paired B3 predictor-reuse benchmark.
Project_YvonMaday/Results_Paper/euclidean_b3_reuse_*/

# Local study outputs and Sherlock comparisons for B3 cubature budgets.
Project_YvonMaday/Results_Paper/euclidean_b3_budget_*/

# Reproducible ECM moment matrices, compression workspaces and timing runs.
# Compact ECM reports and the deployment manifest remain versioned.
Project_YvonMaday/Results_Paper/euclidean_b3_ecm_local/
Project_YvonMaday/Results_Paper/euclidean_b3_ecm_sherlock_*/

# Per-point trajectories and progress from the local PROM Case-2 rank study.
# Its compact protocols and final CSV/JSON summaries remain versioned.
Project_YvonMaday/Results_Paper/euclidean_case2_prom_rank_study/*/

# Sherlock outputs of the nested HPROM enrichment campaign.
Project_YvonMaday/Results_Paper/euclidean_hprom_enrichment_*/
